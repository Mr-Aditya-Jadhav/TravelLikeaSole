{
  "name": "travel-like-a-sole",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts --dev",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "preview": "npm run start",
    "expire-watches": "node --env-file-if-exists=.env --experimental-strip-types server/expire-watches.ts",
    "test": "node --experimental-strip-types --test src/lib/planner.test.ts server/*.test.ts",
    "test:live": "node --env-file-if-exists=.env --experimental-strip-types server/live-check.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.64.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
