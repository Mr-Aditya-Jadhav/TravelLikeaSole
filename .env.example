# Server-only. Never prefix this key with VITE_ or commit a working credential.
TINYFISH_API_KEY=
HOST=127.0.0.1
PORT=5173
DATA_DIRECTORY=.data
MAX_CONCURRENT_JOBS=2
AGENT_TIMEOUT_SECONDS=180
ENABLE_MONITORING=true

# Optional public HTTPS origin for provider-scheduled Monitor webhooks.
# When unset, the server schedules Monitor run-now checks and keeps the provider
# schedule paused; leave the server running to receive local updates.
PUBLIC_APP_URL=

# Set NODE_ENV=production for a public HTTPS deployment; run npm run build first.
